// A tour of cpp-repl with the standard library: cpp-repl examples/stl.repl
// Every bare expression (no semicolon) prints its value.
std::vector<int> v{5, 3, 8, 1};
std::sort(v.begin(), v.end());
v
std::accumulate(v.begin(), v.end(), 0)
std::map<std::string, std::vector<int>> groups{{"odd", {1, 3, 5}}, {"even", {2, 4}}};
groups
groups["odd"].size()
std::optional<double> maybe;
maybe
maybe = 2.5;
maybe
std::make_tuple(1, "two", 3.0)
struct Point { double x, y; };
Point p{1, 2};
p
std::ostream &operator<<(std::ostream &os, const Point &q) { return os << "Point(" << q.x << ", " << q.y << ")"; }
p
for (const auto &[name, values] : groups) {
  std::cout << name << ": " << values.size() << " values\n";
}
%timeit std::sort(v.begin(), v.end());
