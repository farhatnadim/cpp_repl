# A golden session. cpp-repl --batch runs the inputs (the prompt lines) and must
# print this transcript. <any> matches one line, <any lines> any number of them;
# addresses and input_line numbers are normalised.
# args: -p glm
# requires: profile=glm
c++> glm::vec3 v(1, 2, 3);
c++> v
vec3(1, 2, 3)
c++> glm::length(v)
3.7416575
c++> glm::normalize(v)
vec3(0.26726124, 0.5345225, 0.8017837)
c++> glm::cross(v, glm::vec3(0, 0, 1))
vec3(2, -1, 0)
c++> std::vector<glm::vec3>{v, v * 2.0f}
[vec3(1, 2, 3), vec3(2, 4, 6)]
c++> glm::mat4 model = glm::translate(glm::mat4(1.0f), glm::vec3(1, 2, 3));
c++> model
mat4x4
  1  0  0  1
  0  1  0  2
  0  0  1  3
  0  0  0  1
c++> model * glm::vec4(0, 0, 0, 1)
vec4(1, 2, 3, 1)
c++> glm::mat2(1, 2, 3, 4)
mat2x2
  1  3
  2  4
c++> glm::rotate(glm::mat4(1.0f), glm::radians(90.0f), glm::vec3(0, 0, 1))
mat4x4
  -4.371139e-08             -1              0              0
              1  -4.371139e-08              0              0
              0              0     0.99999994              0
              0              0              0              1
c++> glm::quat(1, 0, 0, 0)
quat(1, 0, 0, 0)
